{
  "manifest_version": 3,
  "name": "Universal GitHub Highlighting",
  "version": "1.0.0",
  "description": "Local, language-agnostic WebGPU highlighting for code GitHub leaves uncolored.",
  "minimum_chrome_version": "120",
  "permissions": ["storage", "offscreen", "alarms"],
  "host_permissions": ["https://github.com/*"],
  "background": { "service_worker": "background.js" },
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "GitHub highlighting",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png",
      "48": "icons/icon-48.png",
      "128": "icons/icon-128.png"
    }
  },
  "content_scripts": [{
    "matches": ["https://github.com/*"],
    "js": ["content.js"],
    "css": ["content.css"],
    "run_at": "document_end",
    "world": "ISOLATED"
  }],
  "content_security_policy": {
    "extension_pages": "script-src 'self'; object-src 'none'; connect-src 'none'"
  }
}
